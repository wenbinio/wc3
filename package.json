{
  "name": "wc3-map-toolkit",
  "version": "1.0.0",
  "description": "Headless Warcraft 3 (.w3x) map toolkit: read, write, translate and build maps on Linux",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node scripts/test-suite.cjs",
    "test:smpq": "node scripts/test-suite.cjs --smpq",
    "setup": "bash scripts/setup.sh",
    "test:logic": "node tools/test-map-logic.js",
    "preflight": "node tools/preflight.js",
    "build:after-hours": "node examples/after-hours/build.cjs",
    "automation": "node tools/automation.cjs"
  },
  "dependencies": {
    "fengari": "^0.1.5",
    "luaparse": "^0.3.1",
    "mdx-m3-viewer-th": "^5.13.4",
    "war3-model": "^4.0.1",
    "wc3maptranslator": "5.0.0"
  },
  "optionalDependencies": {
    "stormlib-node": "^1.3.6"
  }
}

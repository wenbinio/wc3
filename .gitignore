# dependencies
node_modules/

# build outputs (map SOURCE folders under maps/ ARE tracked)
_build/
build/
dist/
*.w3x
# ...except the committed compiled maps in maps/builds/ (regenerated via
# tools/build-map.js — see README.md "Committed builds")
!maps/builds/*.w3x
*.w3m
*.mpq
*.mpq.tmp

# scratch
*.log
.tmp/

# optional tools built by scripts/setup.sh (never vendored into git)
vendor/

# Python bytecode caches (trace.py runs generate these)
__pycache__/
*.pyc

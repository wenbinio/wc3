# dependencies
node_modules/

# build outputs (map SOURCE folders under maps/ ARE tracked)
_build/
build/
dist/
*.w3x
# ...except the committed compiled maps in maps/builds/ (regenerated via
# tools/build-map.js — see README.md "Committed builds")
!maps/builds/*.w3x
# ...and the crash-bisection diagnostic variants (see maps/builds/diag/README.md)
!maps/builds/diag/*.w3x
*.w3m
*.mpq
*.mpq.tmp

# scratch
*.log
.tmp/
